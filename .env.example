SFTPGO_ADMIN_PASSWORD=choose-a-password

# FTP and WebDAV are disabled by default (0). To enable, use these exact ports.
FTP_PORT=0              # set to 2121 to enable FTP
FTP_PASSIVE_IP=         # public IP/hostname clients use to reach the gateway (required for FTP)
WEBDAV_PORT=0           # set to 10080 to enable WebDAV
