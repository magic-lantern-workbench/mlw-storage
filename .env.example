SFTPGO_ADMIN_PASSWORD=choose-a-password

# FTP and WebDAV are disabled by default (0). To enable, use these exact ports.
FTP_PORT=0              # set to 2121 to enable FTP
FTP_PASSIVE_IP=         # public IP/hostname clients use to reach the gateway (required for FTP)
WEBDAV_PORT=0           # set to 10080 to enable WebDAV

# Keycloak token login over SFTP (optional). Enable with:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.keycloak.yml
# OIDC_ISSUER=http://localhost:8180/realms/mlw
# OIDC_REQUIRED_ROLE=mlw-user       # realm role needed to log in
# OIDC_READONLY_ROLE=               # realm role that limits a user to list/download
# OIDC_ALLOWED_CLIENTS=             # comma-separated Keycloak client ids (azp); empty = any
